rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCategory(cat) {
      return cat is string && cat in ['사진 합성', '스타일 변환', '캐릭터·포스터'];
    }

    function isValidPromptFields(data) {
      return data.keys().hasAll(['title', 'category', 'content', 'createdAt'])
        && data.keys().hasOnly(['title', 'category', 'content', 'createdAt'])
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && isValidCategory(data.category)
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 20000
        && data.createdAt is timestamp;
    }

    // Startup connectivity check endpoint (read-only)
    match /test/connection {
      allow get: if true;
    }

    // Public beginner prompt library (no login screen required)
    match /prompts/{promptId} {
      allow get: if isValidId(promptId);
      allow list: if true;

      allow create: if isValidId(promptId)
        && isValidPromptFields(incoming())
        && incoming().createdAt == request.time;

      allow update: if isValidId(promptId)
        && isValidPromptFields(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'content']);

      allow delete: if isValidId(promptId);
    }
  }
}
